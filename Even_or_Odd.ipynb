   "source": [
    "# Get input as an integer\n",
    "Number = int(input(\"Enter a number\"))\n",
    "\n",
    "\n",
    "# Check if even or odd\n",
    "if Number % 2 == 0:\n",
    "    print(f\"{Number} is an even number!🎉\")\n",
    "\n",
    "elif Number % 2 != 0:\n",
    "    print(f\"{Number} is an odd number!🎈\")\n",
    "\n",
    "else:\n",
    "    print(\"Enter an number, please🥺\")"
   ]
  }
 ],
