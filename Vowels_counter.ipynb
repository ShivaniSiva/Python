   "source": [
    "#Get input\n",
    "sentence = input(\"Type a sentence!\")\n",
    "\n",
    "vowels_count = 0\n",
    "\n",
    "#Condition\n",
    "for letter in sentence:\n",
    "    print(letter)\n",
    "    if letter in [\"a\", \"e\", \"i\", \"o\", \"u\"]:\n",
    "        vowels_count += 1\n",
    "\n",
    "#Answer\n",
    "print(f\"There are {vowels_count} in the sentence!💕\")\n"
   ]
  }
